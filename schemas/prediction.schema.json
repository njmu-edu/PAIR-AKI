{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAIR-AKI binary prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "receipt"],
  "properties": {
    "label": {"type": "integer", "enum": [0, 1]},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "mode", "model_id", "contract_version", "input_sha256", "bundle_sha256"],
      "properties": {
        "role": {"const": "M_P"},
        "mode": {"enum": ["trained", "synthetic"]},
        "model_id": {"type": "string", "minLength": 1},
        "contract_version": {"const": "mp-binary-v1"},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bundle_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]}
      }
    }
  }
}
